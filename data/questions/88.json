ntColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">div</span>&gt;</span>\n  <span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">p</span>&gt;</span>A<span class=\"hljs-tag\">&lt;/<span class=\"hljs-name\">p</span>&gt;</span>          <span class=\"hljs-comment\">&lt;!-- direct child --&gt;</span>\n  <span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">section</span>&gt;</span>\n    <span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">p</span>&gt;</span>B<span class=\"hljs-tag\">&lt;/<span class=\"hljs-name\">p</span>&gt;</span>        <span class=\"hljs-comment\">&lt;!-- grandchild --&gt;</span>\n  <span class=\"hljs-tag\">&lt;/<span class=\"hljs-name\">section</span>&gt;</span>\n  <span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">h2</span>&gt;</span>C<span class=\"hljs-tag\">&lt;/<span class=\"hljs-name\">h2</span>&gt;</span>\n  <span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">p</span>&gt;</span>D<span class=\"hljs-tag\">&lt;/<span class=\"hljs-name\">p</span>&gt;</span>          <span class=\"hljs-comment\">&lt;!-- sibling immediately after h2 --&gt;</span>\n  <span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">p</span>&gt;</span>E<span class=\"hljs-tag\">&lt;/<span class=\"hljs-name\">p</span>&gt;</span>          <span class=\"hljs-comment\">&lt;!-- later sibling, not adjacent --&gt;</span>\n<span class=\"hljs-tag\">&lt;/<span class=\"hljs-name\">div</span>&gt;</span></code></pre></div><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">css</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"div p     { }   /* A, B, D, E — any descendant */\ndiv &gt; p   { }   /* A, D, E — DIRECT children only */\nh2 + p    { }   /* D — the IMMEDIATELY following sibling */\nh2 ~ p    { }   /* D, E — every following sibling */\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-selector-tag\">div</span> <span class=\"hljs-selector-tag\">p</span>     { }   <span class=\"hljs-comment\">/* A, B, D, E — any descendant */</span>\n<span class=\"hljs-selector-tag\">div</span> &gt; <span class=\"hljs-selector-tag\">p</span>   { }   <span class=\"hljs-comment\">/* A, D, E — DIRECT children only */</span>\n<span class=\"hljs-selector-tag\">h2</span> + <span class=\"hljs-selector-tag\">p</span>    { }   <span class=\"hljs-comment\">/* D — the IMMEDIATELY following sibling */</span>\n<span class=\"hljs-selector-tag\">h2</span> ~ <span class=\"hljs-selector-tag\">p</span>    { }   <span class=\"hljs-comment\">/* D, E — every following sibling */</span></code></pre></div><div class=\"qa-table-wrap\"><table class=\"qa-table\"><thead><tr><th>Symbol</th><th>Name</th><th>Relationship</th></tr></thead><tbody><tr><td>space</td><td>descendant</td><td>any depth below</td></tr><tr><td><code>&gt;</code></td><td>child</td><td>direct child</td></tr><tr><td><code>+</code></td><td>adjacent sibling</td><td>the next sibling</td></tr><tr><td><code>~</code></td><td>general sibling</td><td>all later siblings</td></tr></tbody></table></div><p class=\"qa-summary\">The most common real use is <code>+</code> for spacing between consecutive items:</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">css</span><button type=\"button\" class=\"qa-code-copy\" data-code=\".list &gt; * + * { margin-top: 12px; }   /* every element except the first */\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-selector-class\">.list</span> &gt; * + * { <span class=\"hljs-attribute\">margin-top</span>: <span class=\"hljs-number\">12px</span>; }   <span class=\"hljs-comment\">/* every element except the first */</span></code></pre></div><p class=\"qa-summary\"><strong>Note:</strong> <code>+</code> and <code>~</code> <strong>only look forward</strong>.</p><p class=\"qa-detail\">There is no \"previous sibling\" combinator — to style an element that comes before, reach for <code>:has()</code> (<code>h2:has(+ p)</code>).</p>","references":[{"label":"MDN — CSS combinators","url":"https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Styling_basics/Combinators"},{"label":"MDN — Subsequent-sibling combinator","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/Subsequent-sibling_combinator"}],"related":[{"url":"/q/87-has-selector-la-gi","title":":has() selector là gì?"},{"url":"/q/90-is-where-not-khac-nhau","title":":is(), :where(), :not() khác nhau?"},{"url":"/q/77-cascade-trong-css-nghia-la-gi","title":"Cascade trong CSS nghĩa là gì?"},{"url":"/q/79-inheritance-trong-css-la-gi","title":"Inheritance trong CSS là gì?"},{"url":"/q/80-don-vi-px-em-rem-vw-vh-khac-nhau","title":"Đơn vị px, em, rem, %, vw, vh khác nhau?"},{"url":"/q/81-important-dung-khi-nao-tai-sao-nen-tranh","title":"!important dùng khi nào? Tại sao nên tránh?"},{"url":"/q/91-box-model-gom-nhung-gi","title":"Box model gồm những gì?"},{"url":"/q/92-box-sizing-content-box-vs-border-box","title":"box-sizing: content-box vs border-box?"}]}