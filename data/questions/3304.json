=\"hljs-comment\">// 60 seconds by default</span>\n  }),\n  <span class=\"hljs-attr\">inject</span>: [<span class=\"hljs-title class_\">ConfigService</span>],\n})</code></pre></div><p><strong>Automatic caching</strong> with the interceptor:</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">typescript</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"@UseInterceptors(CacheInterceptor)\n@CacheTTL(5 * 60 * 1000)  // cache-manager v5+ counts MILLISECONDS (5 minutes)\n@Get('products')\nasync getProducts() { ... }\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-meta\">@UseInterceptors</span>(<span class=\"hljs-title class_\">CacheInterceptor</span>)\n<span class=\"hljs-meta\">@CacheTTL</span>(<span class=\"hljs-number\">5</span> * <span class=\"hljs-number\">60</span> * <span class=\"hljs-number\">1000</span>)  <span class=\"hljs-comment\">// cache-manager v5+ counts MILLISECONDS (5 minutes)</span>\n<span class=\"hljs-meta\">@Get</span>(<span class=\"hljs-string\">&#x27;products&#x27;</span>)\n<span class=\"hljs-keyword\">async</span> <span class=\"hljs-title function_\">getProducts</span>(<span class=\"hljs-params\"></span>) { ... }</code></pre></div><p><strong>Manual caching</strong> (more control):</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">typescript</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"constructor(@Inject(CACHE_MANAGER) private cache: Cache) {}\n\nasync getProduct(id: number) {\n  const cached = await this.cache.get&lt;Product&gt;(`product:${id}`);\n  if (cached) return cached;\n\n  const product = await this.repo.findOne({ where: { id } });\n  await this.cache.set(`product:${id}`, product, 300000);  // cache-manager v5 takes MILLISECONDS\n  return product;\n}\n\nasync updateProduct(id: number, dto: UpdateProductDto) {\n  const product = await this.repo.save({ id, ...dto });\n  await this.cache.del(`product:${id}`);  // invalidate\n  return product;\n}\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-title function_\">constructor</span>(<span class=\"hljs-params\"><span class=\"hljs-meta\">@Inject</span>(CACHE_MANAGER) <span class=\"hljs-keyword\">private</span> <span class=\"hljs-attr\">cache</span>: <span class=\"hljs-title class_\">Cache</span></span>) {}\n\n<span class=\"hljs-keyword\">async</span> <span class=\"hljs-title function_\">getProduct</span>(<span class=\"hljs-params\"><span class=\"hljs-attr\">id</span>: <span class=\"hljs-built_in\">number</span></span>) {\n  <span class=\"hljs-keyword\">const</span> cached = <span class=\"hljs-keyword\">await</span> <span class=\"hljs-variable language_\">this</span>.<span class=\"hljs-property\">cache</span>.<span class=\"hljs-property\">get</span>&lt;<span class=\"hljs-title class_\">Product</span>&gt;(<span class=\"hljs-string\">`product:<span class=\"hljs-subst\">${id}</span>`</span>);\n  <span class=\"hljs-keyword\">if</span> (cached) <span class=\"hljs-keyword\">return</span> cached;\n\n  <span class=\"hljs-keyword\">const</span> product = <span class=\"hljs-keyword\">await</span> <span class=\"hljs-variable language_\">this</span>.<span class=\"hljs-property\">repo</span>.<span class=\"hljs-title function_\">findOne</span>({ <span class=\"hljs-attr\">where</span>: { id } });\n  <span class=\"hljs-keyword\">await</span> <span class=\"hljs-variable language_\">this</span>.<span class=\"hljs-property\">cache</span>.<span class=\"hljs-title function_\">set</span>(<span class=\"hljs-string\">`product:<span class=\"hljs-subst\">${id}</span>`</span>, product, <span class=\"hljs-number\">300000</span>);  <span class=\"hljs-comment\">// cache-manager v5 takes MILLISECONDS</span>\n  <span class=\"hljs-keyword\">return</span> product;\n}\n\n<span class=\"hljs-keyword\">async</span> <span class=\"hljs-title function_\">updateProduct</span>(<span class=\"hljs-params\"><span class=\"hljs-attr\">id</span>: <span class=\"hljs-built_in\">number</span>, <span class=\"hljs-attr\">dto</span>: <span class=\"hljs-title class_\">UpdateProductDto</span></span>) {\n  <span class=\"hljs-keyword\">const</span> product = <span class=\"hljs-keyword\">await</span> <span class=\"hljs-variable language_\">this</span>.<span class=\"hljs-property\">repo</span>.<span class=\"hljs-title function_\">save</span>({ id, ...dto });\n  <span class=\"hljs-keyword\">await</span> <span class=\"hljs-variable language_\">this</span>.<span class=\"hljs-property\">cache</span>.<span class=\"hljs-title function_\">del</span>(<span class=\"hljs-string\">`product:<span class=\"hljs-subst\">${id}</span>`</span>);  <span class=\"hljs-comment\">// invalidate</span>\n  <span class=\"hljs-keyword\">return</span> product;\n}</code></pre></div><p>Cache-aside pattern: always invalidate on write, and set the TTL shorter than you strictly need so stale data cannot linger.</p>","references":[],"related":[{"url":"/q/3271-configmodule-va-configservice-trong-nestjs-hoat-dong-nhu-the-nao","title":"ConfigModule và ConfigService trong NestJS hoạt động như thế nào?"},{"url":"/q/3272-cach-viet-unit-tests-va-integration-tests-trong-nestjs","title":"Cách viết unit tests và integration tests trong NestJS?"},{"url":"/q/3278-toi-uu-performance-nestjs-fastify-caching-compression-rate-limiting","title":"Tối ưu performance NestJS: Fastify, Caching, Compression, Rate Limiting?"},{"url":"/q/3280-swagger-openapi-documentation-trong-nestjs-setup-va-cac-annotations-pho-bien","title":"Swagger / OpenAPI documentation trong NestJS — setup và các annotations phổ biến?"},{"url":"/q/3260-nestjs-la-gi-tai-sao-nen-dung-nestjs-thay-vi-express-thuan","title":"NestJS là gì? Tại sao nên dùng NestJS thay vì Express thuần?"},{"url":"/q/3261-module-trong-nestjs-la-gi-giai-thich-cau-truc-module-decorator","title":"Module trong NestJS là gì? Giải thích cấu trúc @Module decorator."},{"url":"/q/3262-controller-trong-nestjs-lam-gi-cach-dinh-nghia-routes-voi-decorators","title":"Controller trong NestJS làm gì? Cách định nghĩa routes với decorators?"},{"url":"/q/3263-provider-va-dependency-injection-trong-nestjs-hoat-dong-nhu-the-nao","title":"Provider và Dependency Injection trong NestJS hoạt động như thế nào?"}]}