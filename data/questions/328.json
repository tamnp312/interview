d\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-keyword\">const</span> user = <span class=\"hljs-title class_\">JSON</span>.<span class=\"hljs-title function_\">parse</span>(raw) <span class=\"hljs-keyword\">as</span> <span class=\"hljs-title class_\">User</span>    <span class=\"hljs-comment\">// an unchecked promise to yourself</span>\n<span class=\"hljs-keyword\">const</span> x = something <span class=\"hljs-keyword\">as</span> <span class=\"hljs-built_in\">unknown</span> <span class=\"hljs-keyword\">as</span> <span class=\"hljs-title class_\">Foo</span>   <span class=\"hljs-comment\">// double assertion — a sign the model is wrong</span></code></pre></div><p>External data must be <strong>validated at runtime</strong>, not asserted:</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">typescript</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"import { z } from 'zod'\nconst UserSchema = z.object({ id: z.number(), name: z.string() })\nconst user = UserSchema.parse(JSON.parse(raw))   // wrong shape throws immediately\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1