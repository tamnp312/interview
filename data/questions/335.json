possibly 'null'\n}\n\n// noImplicitAny — no untyped parameters slipping through\nfunction f(x) { }      // Error: Parameter 'x' implicitly has an 'any' type\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-comment\">// strictNullChecks — the most valuable flag of the set</span>\n<span class=\"hljs-keyword\">function</span> <span class=\"hljs-title function_\">len</span>(<span class=\"hljs-params\"><span class=\"hljs-attr\">s</span>: <span class=\"hljs-built_in\">string</span> | <span class=\"hljs-literal\">null</span></span>) {\n  <span class=\"hljs-keyword\">return</span> s.<span class=\"hljs-property\">length</span>      <span class=\"hljs-comment\">// Error: &#x27;s&#x27; is possibly &#x27;null&#x27;</span>\n}\n\n<span class=\"hljs-comment\">// noImplicitAny — no untyped parameters slipping through</span>\n<span class=\"hljs-keyword\">function</span> <span class=\"hljs-title function_\">f</span>(<span class=\"hljs-params\">x</span>) { }      <span class=\"hljs-comment\">// Error: Parameter &#x27;x&#x27; implicitly has an &#x27;any&#x27; type</span></code></pre></div><p><code>useUnknownInCatchVariables</code> (TS 4.4) is the one that confuses people upgrading older projects:</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">typescript</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"try { risky() }\ncatch (e) {\n  e.message            // Error: 'e' is of type 'unknown'\n  if (e instanceof Error) e.message   // correct\n}\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-keyword\">try</span> { <span class=\"hljs-title function_\">risky</span>() }\n<span class=\"hljs-keyword\">catch</span> (e) {\n  e.<span class=\"hljs-property\">message</span>            <span class=\"hljs-comment\">// Error: &#x27;e&#x27; is of type &#x27;unknown&#x27;</span>\n  <span class=\"hljs-keyword\">if</span> (e <span class=\"hljs-keyword\">instanceof</span> <span class=\"hljs-title class_\">Error</span>) e.<span class=\"hljs-property\">message</span>   <span class=\"hljs-comment\">// correct</span>\n}</code></pre></div><p>Migrating a JavaScript project means enabling them gradually, not all at once:</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">json</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"{ &quot;noImplicitAny&quot;: true }        // step 1\n{ &quot;strictNullChecks&quot;: true }     // step 2 — the heaviest, save it for last\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-punctuation\">{</span> <span class=\"hljs-attr\">&quot;noImplicitAny&quot;</span><span class=\"hljs-punctuation\">:</span> <span class=\"hljs-literal\"><span class=\"hljs-keyword\">true</span></span> <span class=\"hljs-punctuation\">}</span>        <span class=\"hljs-comment\">// step 1</span>\n<span class=\"hljs-punctuation\">{</span> <span class=\"hljs-attr\">&quot;strictNullChecks&quot;</span><span class=\"hljs-punctuation\">:</span> <span class=\"hljs-literal\"><span class=\"hljs-keyword\">true</span></span> <span class=\"hljs-punctuation\">}</span>     <span class=\"hljs-comment\">// step 2 — the heaviest, save it for last</span></code></pre></div><p class=\"qa-summary\"><strong>Takeaway:</strong> new projects should start with <code>strict: true</code>.</p><p class=\"qa-detail\">Turning it on after thousands of lines produces hundreds of errors at once, and most teams disable it again rather than fix them — which is where TypeScript loses most of its value.</p>","references":[{"label":"TypeScript — tsconfig strict","url":"https://www.typescriptlang.org/tsconfig/#strict"},{"label":"TypeScript — strictNullChecks","url":"https://www.typescriptlang.org