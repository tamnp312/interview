pan class=\"hljs-property\">uppercase</span>) val = val.<span class=\"hljs-title function_\">toUpperCase</span>()\n  <span class=\"hljs-title function_\">emit</span>(<span class=\"hljs-string\">&#x27;update:modelValue&#x27;</span>, val)\n}</code></pre></div><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">vue</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"&lt;MyInput v-model.uppercase=&quot;text&quot; /&gt;\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-tag\">&lt;<span class=\"hljs-name\">MyInput</span> <span class=\"hljs-attr\">v-model.uppercase</span>=<span class=\"hljs-string\">&quot;text&quot;</span> /&gt;</span></code></pre></div>","references":[],"related":[{"url":"/q/3217-cac-cach-truyen-data-giua-components-trong-vue","title":"Các cách truyền data giữa components trong Vue?"},{"url":"/q/3218-slots-la-gi-named-slots-va-scoped-slots","title":"Slots là gì? Named slots và scoped slots?"},{"url":"/q/3219-defineexpose-trong-script-setup-la-gi","title":"`defineExpose` trong `<script setup>` là gì?"},{"url":"/q/3200-vue-js-la-gi-khac-react-angular-the-nao","title":"Vue.js là gì? Khác React/Angular thế nào?"},{"url":"/q/3201-options-api-vs-composition-api-khac-nhau-gi","title":"Options API vs Composition API — khác nhau gì?"},{"url":"/q/3202-script-setup-la-gi-loi-ich-so-voi-setup-thong-thuong","title":"`<script setup>` là gì? Lợi ích so với `setup()` thông thường?"},{"url":"/q/3204-single-file-component-sfc-la-gi","title":"Single File Component (SFC) là gì?"},{"url":"/q/3205-cac-directive-pho-bien-trong-vue-v-if-v-show-v-for-v-model-v-bind-v-on","title":"Các directive phổ biến trong Vue: v-if, v-show, v-for, v-model, v-bind, v-on?"}]}