 'learn-react'\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-keyword\">const</span> <span class=\"hljs-title function_\">trim</span>       = (<span class=\"hljs-params\">s</span>) =&gt; s.<span class=\"hljs-title function_\">trim</span>()\n<span class=\"hljs-keyword\">const</span> <span class=\"hljs-title function_\">lower</span>      = (<span class=\"hljs-params\">s</span>) =&gt; s.<span class=\"hljs-title function_\">toLowerCase</span>()\n<span class=\"hljs-keyword\">const</span> <span class=\"hljs-title function_\">slugify</span>    = (<span class=\"hljs-params\">s</span>) =&gt; s.<span class=\"hljs-title function_\">replace</span>(<span class=\"hljs-regexp\">/\\s+/g</span>, <span class=\"hljs-string\">&#x27;-&#x27;</span>)\n\n<span class=\"hljs-title function_\">compose</span>(slugify, lower, trim)(<span class=\"hljs-string\">&#x27; Learn React &#x27;</span>)   <span class=\"hljs-comment\">// reads RIGHT to left</span>\n<span class=\"hljs-title function_\">pipe</span>(trim, lower, slugify)(<span class=\"hljs-string\">&#x27; Learn React &#x27;</span>)      <span class=\"hljs-comment\">// reads LEFT to right — easier</span>\n<span class=\"hljs-comment\">// -&gt; &#x27;learn-react&#x27;</span></code></pre></div><p>Why it beats intermediate variables:</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">javascript</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"// without composition\nconst a = trim(input)\nconst b = lower(a)\nconst c = slugify(b)\n\n// with composition: the pipeline gets a name and can be reused\nconst toSlug = pipe(trim, lower, slugify)\ntitles.map(toSlug)\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-comment\">// without composition</span>\n<span class=\"hljs-keyword\">const</span> a = <span class=\"hljs-title function_\">trim</span>(input)\n<span class=\"hljs-keyword\">const</span> b = <span class=\"hljs-title function_\">lower</span>(a)\n<span class=\"hljs-keyword\">const</span> c = <span class=\"hljs-title function_\">slugify</span>(b)\n\n<span class=\"hljs-comment\">// with composition: the pipeline gets a name and can be reused</span>\n<span class=\"hljs-keyword\">const</span> toSlug = <span class=\"hljs-title function_\">pipe</span>(trim, lower, slugify)\ntitles.<span class=\"hljs-title function_\">map</span>(toSlug)</code></pre></div><p class=\"qa-summary\">Where it shows up in practice: Redux <code>applyMiddleware</code>, RxJS operator chains, PostCSS/Babel plugin pipelines.</p><p class=\"qa-detail\"><strong>Note 1:</strong> every function in the chain must <strong>take exactly one argument</strong>. Multi-argument functions have to be curried first.</p><p class=\"qa-detail\"><strong>Note 2:</strong> plain composition is synchronous. An async step needs its own version:</p><div class=\"qa-code-wrap\"><span class=\"qa-code-lang\">javascript</span><button type=\"button\" class=\"qa-code-copy\" data-code=\"const pipeAsync = (...fns) =&gt; (x) =&gt; fns.reduce((p, f) =&gt; p.then(f), Promise.resolve(x))\" aria-label=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-keyword\">const</span> <span class=\"hljs-title function_\">pipeAsync</span> = (<span class=\"hljs-params\">...fns</span>) =&gt; <span class=\"hljs-function\">(<span class=\"hljs-params\">x</span>) =&gt;</span> fns.<span class=\"hljs-title function_\">reduce</span>(<span class=\"hljs-function\">(<span class=\"hljs-params\">p, f</span>) =&gt;</span> p.<span class=\"hljs-title function_\">then</span>(f), <span class=\"hljs-title class_\">Promise</span>.<span class=\"hljs-title function_\">resolve</span>(x))</code></pre></div>","references":[{"label":"MDN — Array.prototype.reduceRight()","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/reduceRight"},{"label":"Redux — compose","url":"https://redux.js.org/api/compose"}],"related":[{"url":"/q/226-su-khac-biet-giua-function-declaration-function-expression-va-arrow-function-la","title":"Sự khác biệt giữa function declaration, function expression và arrow function là gì?"},{"url":"/q/227-callback-function-la-gi-tai-sao-javascript-dung-callbacks","title":"Callback function là gì? Tại sao JavaScript dùng callbacks?"},{"url":"/q/228-higher-order-function-la-gi-cho-vi-du","title":"Higher-order function là gì? Cho ví dụ."},{"url":"/q/229-iife-immediately-invoked-function-expression-la-gi-va-dung-de-lam-gi","title":"IIFE (Immediately Invoked Function Expression) là gì và dùng để làm gì?"},{"url":"/q/230-pure-function-la-gi-tai-sao-pure-functions-quan-trong","title":"Pure function là gì? Tại sao pure functions quan trọng?"},{"url":"/q/231-currying-la-gi-cho-vi-du-va-truong-hop-dung-thuc-te","title":"Currying là gì? Cho ví dụ và trường hợp dùng thực tế."},{"url":"/q/232-memoization-la-gi-cai-dat-memoization-don-gian-nhu-the-nao","title":"Memoization là gì? Cài đặt memoization đơn giản như thế nào?"},{"url":"/q/234-rest-parameters-args-la-gi-khac-gi-arguments-object","title":"Rest parameters (...args) là gì? Khác gì arguments object?"}]}