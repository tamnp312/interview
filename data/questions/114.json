=\"Copy code\"><svg class=\"qa-code-copy-icon-default\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg><svg class=\"qa-code-copy-icon-done\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"qa-code-copy-label-default\">Copy</span><span class=\"qa-code-copy-label-done\">Copied</span></button><pre class=\"qa-code-pre\"><code class=\"qa-code-block hljs\"><span class=\"hljs-attribute\">grid-template-areas</span>: <span class=\"hljs-string\">&#x27;a . b&#x27;</span>;</code></pre></div><p class=\"qa-summary\"><strong>Note 1:</strong> every string must have the <strong>same number of cells</strong>, and each named area must form a <strong>solid rectangle</strong> — otherwise the whole declaration is dropped, silently.</p><p class=\"qa-detail\"><strong>Note 2:</strong> area names are <strong>not quoted individually</strong> — one row is one string.</p><p class=\"qa-detail\"><strong>Takeaway:</strong> this is the most readable way to write a grid at review time — the declaration shows the layout instead of making you decode <code>grid-column: 1 / 3</code> on each element.</p>","references":[{"label":"MDN — grid-template-areas","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/grid-template-areas"},{"label":"MDN — Grid template areas","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout/Grid_template_areas"}],"related":[{"url":"/q/109-css-grid-la-gi-khac-flexbox-the-nao","title":"CSS Grid là gì? Khác Flexbox thế nào?"},{"url":"/q/110-fr-unit-la-gi","title":"fr unit là gì?"},{"url":"/q/111-grid-template-columns-va-grid-template-rows-hoat-dong-the-nao","title":"grid-template-columns và grid-template-rows hoạt động thế nào?"},{"url":"/q/112-auto-fit-va-auto-fill-khac-nhau","title":"auto-fit và auto-fill khác nhau?"},{"url":"/q/77-cascade-trong-css-nghia-la-gi","title":"Cascade trong CSS nghĩa là gì?"},{"url":"/q/79-inheritance-trong-css-la-gi","title":"Inheritance trong CSS là gì?"},{"url":"/q/80-don-vi-px-em-rem-vw-vh-khac-nhau","title":"Đơn vị px, em, rem, %, vw, vh khác nhau?"},{"url":"/q/81-important-dung-khi-nao-tai-sao-nen-tranh","title":"!important dùng khi nào? Tại sao nên tránh?"}]}